// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

SIMPLE_SLASH=/

// IMPULSEM_RPC_URL, IMPULSEM_SITE_URL, IMPULSEM_LINK_HOST and IMPULSEM_MACOS_FEED_URL are not defined here.
// Set them as build settings (xcodebuild IMPULSEM_RPC_URL=...) or as environment variables.
// Empty means not configured: the app then stays disconnected and hides the owner-host features.

WEBRTC_MAC = 1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) WEBRTC_MAC=$(WEBRTC_MAC)
